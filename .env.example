# Public browser configuration only. Never put service-role keys here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional public JSON endpoint consumed by the read-only tender source adapter.
# Leave empty to use local demo data.
VITE_TENDER_SOURCE_URL=

# Server-side Supabase/Stripe secrets belong in Supabase Edge Function secrets, NOT here.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_STARTER_PRICE_ID=
# STRIPE_PRO_PRICE_ID=
# STRIPE_BUSINESS_PRICE_ID=
# APP_URL=https://your-production-domain.example
